{
  "name": "@jaringan-dagang/beli-aman-sdk",
  "version": "0.1.0",
  "description": "Embeddable buyer-protection / escrow modal + identity provider for Indonesian DTC commerce. Beckn-protocol-backed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetatechID/beli-aman-sdk.git"
  },
  "homepage": "https://github.com/MetatechID/beli-aman-sdk#readme",
  "bugs": "https://github.com/MetatechID/beli-aman-sdk/issues",
  "keywords": [
    "beli-aman",
    "escrow",
    "buyer-protection",
    "beckn",
    "jaringan-dagang",
    "indonesia",
    "commerce",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "echo 'no SDK tests yet — wire vitest in a follow-up'",
    "lint": "echo 'no SDK lint yet — wire eslint in a follow-up'",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "//dependencies": "Will add @jaringan-dagang/beckn-protocol ^0.1.0 once that package publishes to npm (migration Step 2 in jaringan-dagang-protocol repo). Empty deps lets pnpm install bootstrap on day 1.",
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "firebase": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
